# ===== 基础行为 =====
# mock = 内置假数据（先跑通流程）；http = 轮询真实接口
SOURCE=mock

# 轮询间隔（秒）。60 秒足够，别设太小，容易把接口打挂或触发风控
POLL_INTERVAL_SECONDS=60

# 报名开始前多少分钟提醒
LEAD_MINUTES=5

# 补救窗口：如果进程刚好在那几分钟里挂了，报名开始后 GRACE_MINUTES 内
# 还会补发一条「报名已开始」，超过就放弃（避免刷屏历史活动）
GRACE_MINUTES=10

# 状态文件（去重、基线都用它）
STATE_FILE=./data/state.json

# 通知渠道，逗号分隔：console / desktop / file / wecom / pushplus / webhook
#   console  打在终端里
#   desktop  系统原生通知（Linux 需要通知守护进程，见 README）
#   file     追加到 ALERT_LOG，留一份记录
NOTIFIERS=console,desktop,file

# file 渠道的记录文件
ALERT_LOG=./data/alerts.md

# ===== 数据源：SOURCE=http 时生效 =====
# 抓包拿到的活动列表接口
SOURCE_URL=
SOURCE_METHOD=GET
# JSON 字符串，注意要用双引号包起来再转义，例如：
# SOURCE_HEADERS={"Cookie":"SESSION=xxx","User-Agent":"MicroMessenger/8.0.49"}
SOURCE_HEADERS=
# 只有 POST 才需要
SOURCE_BODY=
# 活动数组在响应里的位置，点号路径；留空表示响应本身就是数组
SOURCE_ITEMS_PATH=
# 字段映射：左边固定，右边填接口里的真实字段名（支持点号路径）
SOURCE_FIELD_ID=id
SOURCE_FIELD_TITLE=title
SOURCE_FIELD_SIGNUP_START=signupStart
SOURCE_FIELD_SIGNUP_END=
SOURCE_FIELD_EVENT_START=
SOURCE_FIELD_URL=

# ===== 渠道：企业微信群机器人 =====
# 群设置 → 群机器人 → 添加 → 复制 Webhook 地址
WECOM_WEBHOOK=

# ===== 渠道：PushPlus（推到微信） =====
PUSHPLUS_TOKEN=
PUSHPLUS_TOPIC=

# ===== 渠道：通用 Webhook（自己接 n8n / 自建服务） =====
GENERIC_WEBHOOK_URL=
